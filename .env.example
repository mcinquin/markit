# ─── Base de données ─────────────────────────────────────────────────────────
POSTGRES_USER=markit
POSTGRES_DB=markit
# Générer avec : openssl rand -base64 32
# (les caractères + / = sont gérés : l'entrypoint Docker encode l'URL automatiquement)
POSTGRES_DB_PASSWORD=

# Optionnel : URL complète (mot de passe encodé). Sinon construite depuis les variables ci-dessus.
# DATABASE_URL=postgresql://markit:...@postgres:5432/markit

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://markit.example.com
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── Compte admin initial (utilisé uniquement au premier démarrage) ───────────
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
# Minimum 12 caractères
ADMIN_PASSWORD=
